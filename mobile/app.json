{
  "expo": {
    "name": "EdgePilot AI",
    "slug": "edgepilot-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "edgepilot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C1F19"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.edgepilot.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "EdgePilot AI",
        "NSUserTrackingUsageDescription": "EdgePilot does not track you across apps. This permission is unused.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0C1F19"
      },
      "package": "ai.edgepilot.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
