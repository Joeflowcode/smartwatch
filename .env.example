# Optional. v1 does not need a Google key to show the ordered list
# or to open phone Maps deep links.
# VITE_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
#
# Optional JSON feed you host (array of sales, or { "sales": [...] }).
# Same shape as a pasted list. Not a scrape of EstateSales.net.
# VITE_SALES_FEED_URL=/feeds/example.json
#
# Licensed partner lookup by ZIP (server-only — never put secrets in VITE_*).
# Leave unset until you have a written read API. Placeholders:
# {zip} {zip3} {city} {state} {start} {end}
# SALES_FEED_TEMPLATE=https://partner.example/weekend?zip={zip}&from={start}&to={end}
# SALES_FEED_URL=https://partner.example/weekend.json
# SALES_FEED_TOKEN=
# SALES_FEED_HEADER=Authorization
